      "TelemetrySample": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "site_id",
          "asset_id",
          "sample_sequence",
          "sampled_at",
          "metric",
          "unit",
          "quality"
        ],
        "properties": {
          "fixture_id": {
            "const": "TITAN-WTP-01"
          },
          "site_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63
          },
          "asset_id": {
            "type": "string",
            "pattern": "^WTP01-PMP-\\d{3}$"
          },
          "sample_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "sampled_at": {
            "type": "string",
            "format": "date-time"
          },
          "metric": {
            "$ref": "#/components/schemas/TelemetryMetric"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "$ref": "#/components/schemas/TelemetryUnit"
          },
          "quality": {
            "$ref": "#/components/schemas/TelemetryQuality"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "metric": {
                  "const": "pressure"
                }
              },
              "required": [
                "metric"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "kPa"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metric": {
                  "const": "flow"
                }
              },
              "required": [
                "metric"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "m3/h"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metric": {
                  "const": "vibration"
                }
              },
              "required": [
                "metric"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "mm/s"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metric": {
                  "const": "temperature"
                }
              },
              "required": [
                "metric"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "degC"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quality": {
                  "const": "missing"
                }
              },
              "required": [
                "quality"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "quality": {
                  "enum": [
                    "good",
                    "suspect"
                  ]
                }
              },
              "required": [
                "quality"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ]
      },
