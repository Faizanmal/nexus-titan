# NEXUS TITAN environment template (placeholders only; never commit real secrets).
# Local:  cp .env.example .env
# Prod:   cp .env.example .env.production  then set APP_ENV=production and domain values.
# docker-compose.yml reads `.env`; docker-compose.prod.yml uses `--env-file .env.production`.

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# firebase = real Firebase AI Logic; fixture = no live inference requests.
NEXT_PUBLIC_INFERENCE_PROVIDER=firebase

# ------------------------------------------------------------------------------
# PostgreSQL (local Compose + host tools)
# docker-compose.yml / docker-compose.prod.yml interpolate POSTGRES_* into DATABASE_URL.
# ------------------------------------------------------------------------------
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexus_dev
DATABASE_URL=postgresql://nexus_dev:change-me-local-only@127.0.0.1:5432/nexus_dev

# ------------------------------------------------------------------------------
# Optional local profiles (docker-compose.yml: distributed / graph)
# Compose overrides NATS_URL / NEO4J_URI inside containers; host defaults below.
# ------------------------------------------------------------------------------
NATS_URL=nats://127.0.0.1:4222
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
# Optional override for world fixture path (defaults to repo fixtures when unset).
WORLD_FIXTURE_DIR=

# ------------------------------------------------------------------------------
# Firebase / identity (API + web)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional server-side API key; falls back to NEXT_PUBLIC_FIREBASE_API_KEY when unset.
FIREBASE_API_KEY=
# Production Admin SDK / token revocation (path to a local ignored credentials file).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Server-side emulator endpoints. Keep unset outside local development.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECTIONS_ENABLED=false
ALLOW_APPCHECK_BYPASS=false
# Optional judge/demo actor fallback in production/staging (defaults to false)
ALLOW_DEMO_ACTOR=false
# Set true only when APP_ENV=local, Auth emulator is on loopback, and server bypass is enabled.
NEXT_PUBLIC_APPCHECK_EMULATOR_BYPASS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local debug App Check only. Never commit a real debug token.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Optional local Auth/Firestore emulators. AI Logic always uses the real Firebase backend.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
# Optional AI backend overrides (defaults: Google AI / gemini-2.0-flash).
NEXT_PUBLIC_FIREBASE_AI_BACKEND=
NEXT_PUBLIC_FIREBASE_VERTEX_LOCATION=global
NEXT_PUBLIC_FIREBASE_CLOUD_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Production VM (docker-compose.prod.yml + scripts/deploy-vm.sh)
# Copy this file to ignored `.env.production`, then set:
#   APP_ENV=production
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (strong password; not change-me-local-only)
#   DOMAIN_* / ACME_EMAIL / NEXT_PUBLIC_API_URL
#   Firebase client + FIREBASE_PROJECT_ID / FIREBASE_APP_ID when using live App Check / AI
# Compose sets CORS_ORIGINS from DOMAIN_WEB and ALLOW_APPCHECK_BYPASS=false.
# ------------------------------------------------------------------------------
DOMAIN_WEB=app.yourdomain.com
DOMAIN_API=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
# Example production values (edit in .env.production; do not use for local):
# APP_ENV=production
# POSTGRES_USER=nexus_admin
# POSTGRES_PASSWORD=replace-with-a-secure-random-password
# POSTGRES_DB=nexus_titan
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_INFERENCE_PROVIDER=fixture
