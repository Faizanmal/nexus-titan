APP_ENV=local
# Local Compose credentials only; replace for any shared environment.
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexus_dev
DATABASE_URL=postgresql://nexus_dev:change-me-local-only@127.0.0.1:5432/nexus_dev
NEO4J_PASSWORD=change-me-local-only
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server-side emulator endpoints. Keep these unset outside local development.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECTIONS_ENABLED=false
ALLOW_APPCHECK_BYPASS=false
# Set true only when APP_ENV=local, Auth emulator is on loopback, and server bypass is enabled.
NEXT_PUBLIC_APPCHECK_EMULATOR_BYPASS=false
# firebase invokes real Firebase AI Logic; fixture disables all inference requests.
NEXT_PUBLIC_INFERENCE_PROVIDER=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set true only for local development.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false
# Optional: paste the App Check debug token from Firebase Console (Manage debug tokens).
# Leave empty to have the SDK print a UUID in DevTools for you to register instead.
# Never commit a real token.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Optional local Auth/Firestore emulators. AI Logic always uses the real Firebase backend.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
