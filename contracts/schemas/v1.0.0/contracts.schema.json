{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexus-titan.dev/v1.0.0/contracts.schema.json",
  "title": "NEXUS TITAN Wire Contracts v1.0.0",
  "$defs": {
    "TenantId": {
      "title": "TenantId",
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9_-]{2,62}$"
    },
    "SchemaVersion": {
      "title": "SchemaVersion",
      "type": "string",
      "enum": ["1.0.0"]
    },
    "DataClassification": {
      "title": "DataClassification",
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "EventSource": {
      "title": "EventSource",
      "type": "string",
      "enum": ["device", "api", "worker", "peer", "simulator"]
    },
    "RiskTier": {
      "title": "RiskTier",
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "SimulationStatus": {
      "title": "SimulationStatus",
      "type": "string",
      "enum": ["completed", "rejected"]
    },
    "PolicyOutcome": {
      "title": "PolicyOutcome",
      "type": "string",
      "enum": ["allow", "deny", "review"]
    },
    "ErrorCode": {
      "title": "ErrorCode",
      "type": "string",
      "enum": ["VALIDATION_ERROR", "TENANT_SCOPE_VIOLATION", "POLICY_DENIED", "CONFLICT", "NOT_FOUND", "NOT_IMPLEMENTED", "INTERNAL_ERROR"]
    },
    "Event": {
      "title": "Event",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "schema_version", "event_type", "source", "sequence", "occurred_at", "classification", "payload"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "source": { "$ref": "#/$defs/EventSource" },
        "sequence": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "classification": { "$ref": "#/$defs/DataClassification" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "EventBatch": {
      "title": "EventBatch",
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "events"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "events": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/Event" } }
      }
    },
    "Vector3": {
      "title": "Vector3",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "SimulationBody": {
      "title": "SimulationBody",
      "type": "object",
      "additionalProperties": false,
      "required": ["body_id", "position", "velocity", "mass_kg"],
      "properties": {
        "body_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "position": { "$ref": "#/$defs/Vector3" },
        "velocity": { "$ref": "#/$defs/Vector3" },
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "SimulationRequest": {
      "title": "SimulationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_id", "tenant_id", "schema_version", "classification", "solver_id", "time_step_seconds", "max_iterations", "bodies"],
      "properties": {
        "simulation_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "classification": { "$ref": "#/$defs/DataClassification" },
        "solver_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
        "time_step_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "bodies": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/SimulationBody" } },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "SimulationResult": {
      "title": "SimulationResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_id", "tenant_id", "schema_version", "status", "result"],
      "properties": {
        "simulation_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "status": { "$ref": "#/$defs/SimulationStatus" },
        "result": { "type": "object", "additionalProperties": true }
      }
    },
    "AgentRoleDescriptor": {
      "title": "AgentRoleDescriptor",
      "description": "Role registration declares its input/output JSON Schemas and risk tier. Concrete roles are supplied by the master spec.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "risk_tier", "input_schema", "output_schema"],
      "properties": {
        "role_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "input_schema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } }, "additionalProperties": true },
        "output_schema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } }, "additionalProperties": true }
      }
    },
    "AgentInvocation": {
      "title": "AgentInvocation",
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "tenant_id", "schema_version", "role_id", "risk_tier", "input"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "role_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "input": { "type": "object", "additionalProperties": true },
        "classification": { "$ref": "#/$defs/DataClassification" }
      }
    },
    "AgentResult": {
      "title": "AgentResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "tenant_id", "schema_version", "role_id", "risk_tier", "output"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "role_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "output": { "type": "object", "additionalProperties": true },
        "classification": { "$ref": "#/$defs/DataClassification" }
      }
    },
    "PolicyDecision": {
      "title": "PolicyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "outcome", "reason_code", "policy_version"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/TenantId" },
        "outcome": { "$ref": "#/$defs/PolicyOutcome" },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "ErrorDetail": {
      "title": "ErrorDetail",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "request_id": { "type": "string", "format": "uuid" },
        "details": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "ErrorResponse": {
      "title": "ErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "$ref": "#/$defs/ErrorDetail" }
      }
    },
    "HealthStatus": {
      "title": "HealthStatus",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "service"],
      "properties": {
        "status": { "const": "ok" },
        "service": { "const": "nexus-titan-api" }
      }
    }
  }
}
