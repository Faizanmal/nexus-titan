{
  "name": "nexus-titan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @nexus-titan/web dev",
    "lint": "pnpm -r lint",
    "lint:python": "uv run --project services/api ruff check . && uv run --project services/api black --check .",
    "lint:all": "pnpm lint && pnpm lint:python",
    "format:python": "uv run --project services/api ruff check --fix . && uv run --project services/api black .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:suites",
    "test:suites": "node tests/firebase-config.test.mjs && node tests/firebase-inference-source.test.mjs && node tests/android-scaffold.test.mjs && node tests/ios-scaffold.test.mjs && node tests/cross-platform-interop.test.mjs && node tests/flagship-scenario.test.mjs && node tests/flagship-hybrid-incident.test.mjs && node --experimental-strip-types tests/flagship-hybrid-unit.test.mjs && node tests/flagship-guided-ui.test.mjs && node tests/contradiction-comparison.test.mjs && node tests/judge-browser-smoke.test.mjs && node tests/chaos-recovery.test.mjs && node tests/e2e-workflow.test.mjs && node tests/security-review.test.mjs",
    "test:judge-smoke": "node tests/judge-browser-smoke.test.mjs",
    "test:api": "uv run --project services/api pytest",
    "test:all": "pnpm test && pnpm test:api",
    "build": "pnpm --filter @nexus-titan/web build",
    "dev:services": "docker compose --profile core up --build",
    "setup": "python scripts/task.py setup",
    "migrate": "python scripts/task.py migrate",
    "seed": "python scripts/task.py seed",
    "smoke": "python scripts/task.py smoke",
    "reset-demo": "python scripts/task.py reset-demo",
    "integration": "python scripts/task.py integration core",
    "compose:check": "python scripts/task.py compose-check",
    "contracts:generate": "python scripts/generate-contracts.py",
    "contracts:check": "python scripts/generate-contracts.py --check",
    "world:generate": "python scripts/generate-world-fixture.py --check-deterministic",
    "telemetry:generate": "python scripts/generate-telemetry.py --check-deterministic",
    "telemetry:simulate": "python scripts/task.py telemetry-simulate --tenant demo-nexus --confirm demo-nexus",
    "world:seed": "python scripts/task.py world-seed",
    "world:graph:rebuild": "python scripts/task.py graph-rebuild",
    "firebase:check": "node tests/firebase-config.test.mjs && node tests/firebase-inference-source.test.mjs",
    "android:check": "node tests/android-scaffold.test.mjs",
    "ios:check": "node tests/ios-scaffold.test.mjs",
    "interop:check": "node tests/cross-platform-interop.test.mjs",
    "flagship:check": "node tests/flagship-scenario.test.mjs",
    "flagship:hybrid:check": "node tests/flagship-hybrid-incident.test.mjs && node --experimental-strip-types tests/flagship-hybrid-unit.test.mjs",
    "chaos:check": "node tests/chaos-recovery.test.mjs",
    "e2e:check": "node tests/e2e-workflow.test.mjs",
    "security:check": "node tests/security-review.test.mjs",
    "security:audit": "python scripts/security-audit.py",
    "eval:comprehensive": "python scripts/evaluate-comprehensive.py",
    "benchmark:suite": "python scripts/benchmark-suite.py",
    "a11y:check": "node apps/web/tests/accessibility.test.mjs",
    "design:check": "node apps/web/tests/design-system.test.mjs",
    "firebase:rules:test": "pnpm --filter @nexus-titan/web test:identity-rules",
    "firebase:rules:emulated": "pnpm dlx firebase-tools@15.36.0 emulators:exec --project demo-nexus-identity-rules --only firestore,storage \"pnpm firebase:rules:test\""
  },
  "devDependencies": {
    "@nexus-titan/contracts": "workspace:*",
    "@nexus-titan/hybrid-web": "workspace:*",
    "typescript": "^5.9.3"
  }
}
